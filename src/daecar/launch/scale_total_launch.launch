<launch>
  <!-- <node name="dae_main_test" type="dae_main_test.py" pkg="daecar" output="screen"/> -->
  <node name="main_20" type="main_20.py" pkg="daecar" output="screen"/> 
  <!-- <node name="main_class_run" type="main_class_hsv.py" pkg="daecar" output="screen"/> -->
  <!-- <node name="lidar_example" type="detect_clust_obs.py" pkg="daecar" output="screen"/> -->
  <node name="lidar_example" type="my_detect_obs.py" pkg="daecar" output="screen"/>
  <node name="sign_id" type="child_sign.py" pkg="daecar" output="screen"/>
  <node name="rabacon_drive" type="rabacon_drive.py" pkg="daecar" output="screen"/>
  <!-- <node name="turnnel_drive" type="turnnel_drive.py" pkg="daecar" output="screen"/> -->
  <!-- usb_cam, lidar, joystick turn on launch -->
  <include file="$(find racecar)/launch/teleop.launch"/>
  
  <!-- <include file="$(find obstacle_detector)/launch/nodes.launch"/> -->
  <include file="$(find obstacle_detector)/launch/nodelets.launch"/>
  <include file="$(find ar_track_alvar)/launch/pr2_indiv_no_kinect.launch"/>
	<!-- <include file="$(find ar_track_alvar)/launch/pr2_bundle_no_kinect.launch"/> -->

  <!-- <include file="$(find aruco_detect)/launch/aruco_detect.launch" /> -->
  <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find rplidar_ros)/rviz/rplidar.rviz" /> -->
  
  <node name="image_proc" pkg="image_proc" type="image_proc" ns="usb_cam"/>
      
  <node name="image_rect_color_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    <remap from="image" to="/usb_cam/image_rect_color"/>
    <param name="autosize" value="true" />
  </node>
    
</launch>

